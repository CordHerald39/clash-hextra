---
import {pages,articles,href,config,indexable} from '../lib/content.mjs';
import '../styles/site.css';
import AirportGuide from '../components/AirportGuide.astro';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.slug||undefined},props:{page}}))}
const {page}=Astro.props;const home=!page.slug;const article=page.slug.startsWith('blog/');
const canonical=new URL(page.slug?page.slug+'/':'',config.site).href;
const updated=new Date(page.lastmod||page.date||'2026-09-30').toLocaleDateString('zh-CN');
const groups=[{title:'下载安装',items:[['downloads','全部客户端下载'],['mobile','Android 手机版'],['desktop','Windows 电脑版'],['blog/official','官网来源辨认']]},{title:'配置与连接',items:[['tutorials','使用教程总览'],['blog/android','安卓首次连接'],['blog/windows','Windows 安装包'],['blog/subscription','订阅更新失败']]},{title:'使用与维护',items:[['blog/modes','模式与接管范围'],['blog/backup','升级与备份'],['blog','全部文章'],['recommend','机场推荐']]}];
const schema={'@context':'https://schema.org','@type':article?'Article':'WebPage',headline:page.title,url:canonical,description:page.description,...(article?{datePublished:page.date,dateModified:page.lastmod||page.date,author:{'@type':'Organization',name:'Clash 编辑组'}}:{})};
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{home?page.title:`${page.title} | ${config.title}`}</title><meta name="description" content={page.description||config.description}/><meta name="robots" content={indexable?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="Clash 文章" href={href('rss.xml')}/><meta property="og:title" content={page.title}/><meta property="og:description" content={page.description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}></script></head>
<body><a class="skip" href="#main">跳到正文</a><header class="topbar"><a class="brand" href={href('')}><svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="6" fill="currentColor"/><path d="M8 7h12M8 14h9M8 21h12" stroke="white" stroke-width="2"/></svg><span>Clash <b>文档中心</b></span></a><nav aria-label="顶栏"><a href={href('downloads/')}>软件下载</a><a href={href('blog/')}>文章索引</a><a href={href('recommend/')}>机场推荐</a><a href={href('about/')}>关于本站</a></nav><span class="top-note">中文使用手册</span></header>
<div class="layout"><aside class="sidebar"><a class="overview" href={href('')} aria-current={home?'page':undefined}>文档概览</a>{groups.map(group=><details open={home||group.items.some(([slug])=>slug===page.slug)}><summary>{group.title}</summary><nav aria-label={group.title}>{group.items.map(([slug,name])=><a href={href(slug+'/')} aria-current={page.slug===slug?'page':undefined}>{name}</a>)}</nav></details>)}<p class="source-note">下载入口连接开发者发布页。<br/>配置问题按具体客户端查找。</p></aside>
<main id="main">{home?<><div class="home-intro"><p class="location">帮助与文档 / 概览</p><h1>Clash 中文文档<br/>安装、订阅与使用教程</h1><p>从选安装包到处理连接错误，按你正在做的事情查找。</p><label class="searchbox"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.8"/></svg><input id="article-search" type="search" aria-label="搜索文档" placeholder="搜索订阅、安卓安装、规则模式…"/><span>{articles.length} 篇指南</span></label><p id="search-status" role="status"></p></div><div class="start-panel"><div><h2>第一次使用？</h2><p>先按设备选客户端，安装完成后继续配置教程。</p></div><a href={href('downloads/')}>选择下载版本</a><a href={href('tutorials/')}>开始配置</a></div><section class="chapters"><h2>按章节阅读</h2><div class="chapter-grid">{groups.map(group=><details open><summary>{group.title}</summary><ul>{group.items.map(([slug,name])=><li><a href={href(slug+'/')}>{name}</a></li>)}</ul></details>)}</div></section><section class="article-section"><h2>问题与解答</h2><div class="article-list">{articles.map(a=><a class="article-item" data-post data-text={a.title+' '+a.description} href={href(a.slug+'/')}><h3>{a.title}</h3><p>{a.description}</p><span>阅读指南</span></a>)}</div></section></>:<><nav class="breadcrumb" aria-label="当前位置"><a href={href('')}>文档</a><span>/</span><span>{article?'问题与解答':page.title}</span></nav><header class="page-head"><h1>{page.title}</h1><p>{page.description}</p>{article&&<small>更新于 {updated}</small>}</header><div class="reading-layout"><div class="reading">{page.slug==='recommend'?<AirportGuide link={href} download="downloads/" tutorial="tutorials/"/>:<article class="prose" set:html={page.html}/>}{page.slug==='blog'&&<><label class="searchbox"><input id="article-search" type="search" aria-label="搜索文章" placeholder="搜索文章标题与摘要"/></label><p id="search-status" role="status"></p><div class="article-list">{articles.map(a=><a class="article-item" data-post data-text={a.title+' '+a.description} href={href(a.slug+'/')}><h2>{a.title}</h2><p>{a.description}</p><span>阅读指南</span></a>)}</div></>}{article&&<div class="article-end"><a href={href('blog/')}>返回文章索引</a><a href={href('tutorials/')}>使用教程</a></div>}</div>{page.toc.length>0&&<aside class="toc"><p>本页目录</p>{page.toc.map(t=><a href={'#'+t.id}>{t.text}</a>)}</aside>}</div></>}
<footer><span>© 2026 Clash 中文文档</span><nav aria-label="页脚"><a href={href('about/')}>关于</a><a href={href('privacy/')}>隐私</a><a href={href('rss.xml')}>RSS</a></nav></footer></main></div>
<script>const input=document.querySelector<HTMLInputElement>('#article-search');if(input)input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let n=0;document.querySelectorAll<HTMLElement>('[data-post]').forEach(item=>{item.hidden=!item.dataset.text?.toLowerCase().includes(q);if(!item.hidden)n++});document.querySelector('#search-status')!.textContent=q?(n?n+' 篇相关指南':'没有匹配文章，试试“订阅”或“安装”。'):'';});</script>
</body></html>

